{
  "name": "agentsmith",
  "version": "0.1.0",
  "description": "Cross-environment agent asset manager — install, sync, and update agent skills, instructions, and agents across VS Code, Kiro, Antigravity, and more.",
  "keywords": [
    "ai",
    "agents",
    "copilot",
    "kiro",
    "antigravity",
    "skills",
    "instructions",
    "cli"
  ],
  "homepage": "https://github.com/CTOUT/agentsmith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CTOUT/agentsmith.git"
  },
  "bugs": {
    "url": "https://github.com/CTOUT/agentsmith/issues"
  },
  "license": "MIT",
  "author": "CTOUT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "agentsmith": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --no-experimental-strip-types node_modules/vitest/vitest.mjs run src/utils/paths.test.ts src/lifecycle/recommendations.test.ts src/utils/frontmatter.test.ts src/lifecycle/hash.test.ts src/targets/targets.test.ts src/sources/awesome-copilot.test.ts src/lifecycle/lifecycle.test.ts src/cli/picker.test.ts src/cli.test.ts",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "prepublishOnly": "npm run build && npm test",
    "spellcheck": "npx --yes cspell \"**\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.2",
    "commander": "^13.1.0",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^10.12.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
